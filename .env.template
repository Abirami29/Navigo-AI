# Lakebase (Postgres) connection
LAKEBASE_HOST=your-lakebase-instance.database.cloud.databricks.com
LAKEBASE_PORT=5432
LAKEBASE_DB=navigo
LAKEBASE_USER=navigo_app
LAKEBASE_PASSWORD=changeme

# Databricks workspace (for Model Serving / Vector Search calls)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-personal-access-token

# Model Serving endpoint name used by the agent
NAVIGO_MODEL_SERVING_ENDPOINT=databricks-meta-llama-3-70b-instruct

# Vector Search
NAVIGO_VECTOR_SEARCH_ENDPOINT=navigo_vector_endpoint
NAVIGO_VECTOR_INDEX=navigo.default.activities_index

# External APIs (no keys required, listed for clarity)
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com
WIKIMEDIA_BASE_URL=https://en.wikipedia.org/api/rest_v1
OVERPASS_API_URL=https://overpass-api.de/api/interpreter